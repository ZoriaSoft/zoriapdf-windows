{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZoriaPDF",
  "version": "1.1.3",
  "identifier": "com.zoriasoft.pdf.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"ZoriaPDF","width":1360,"height":900,"minWidth":1000,"minHeight":680,"dragDropEnabled":true}],
    "security": {"csp":"default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"}
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {"resources/":"resources/"},
    "fileAssociations": [{"ext":["pdf"],"name":"PDF belgesi","role":"Editor","mimeType":"application/pdf"}],
    "windows": {
      "certificateThumbprint": "2DAD8A5D6E1721F9BBF8CB42052EE7AA5859524C",
      "digestAlgorithm": "sha256",
      "nsis":{"displayLanguageSelector":false,"languages":["Turkish","English"]}
    }
  }
}
